# macOS system files
.DS_Store

# Karabiner-Elements configuration files
karabiner/.*.swp
karabiner/private.json

# Wezterm configuration files
wezterm/.*.swp
wezterm/wezterm.toml

# Zsh configuration files
zsh/.*.swp

# Yazi configuration files
yazi/.*.swp

# Git configuration folder (if you're using the .git folder inside your dotfiles directory)
.git/

# Temporary files
*~
*.swp
*.swo
*.bak

# Backup and temporary files
*.bak
*.tmp
*.swp

# Timestamped backups (e.g. karabiner.json.bak.20260818_000318)
*.bak.*

# Embedded git repositories (plugin managers: tpm, lazy.nvim, nvim-kickstart, etc.)
# Adding them breaks clones (gitlink with empty content). Exclude to keep dotfiles clean.
**/.git
tmux/.config/tmux/.tmux/plugins/
nvim-main/.config/nvim/lazy/
nvim-linkarzu/.config/nvim/lazy/
nvim-kickstart/.config/nvim/
nvim-kickstart/.config/nvim

# Mirror of real HOME (don't duplicate ~/.config into dotfiles)
HOME/.config
